# Table requests: configure at least ONE channel. With none, every booking UI shows
# "Online table requests aren't switched on yet — call (951) 780-1132" and nothing is sent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never NEXT_PUBLIC_
# NEXT_PUBLIC_SUPABASE_URL= / NEXT_PUBLIC_SUPABASE_ANON_KEY= also work for the insert (existing RLS insert policy)
RESEND_API_KEY=
RESTAURANT_EMAIL=                     # who receives table requests
RESEND_FROM=                          # e.g. "Gra Pow Reservations <reservations@your-verified-domain>"
DISCORD_WEBHOOK_URL=
GOOGLE_SHEETS_SCRIPT_URL=
NEXT_PUBLIC_SITE_URL=https://grapow.net
